    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst obj = items[0].json;\n\n// Recursively get the last object's gid\nfunction getLastGid(o) {\n  let lastGid = null;\n\n  for (const key of Object.keys(o)) {\n    const value = o[key];\n    if (value && typeof value === 'object' && !Array.isArray(value)) {\n      lastGid = getLastGid(value); // dive deeper\n    }\n  }\n\n  // If this object itself has gid, overwrite lastGid\n  if (o.gid) {\n    lastGid = o.gid;\n  }\n\n  return lastGid;\n}\n\nconst lastGid = getLastGid(obj);\n\nreturn [{ json: { gid: lastGid } }];\n"
      },
