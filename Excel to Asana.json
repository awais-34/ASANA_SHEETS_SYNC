      "name": "Get all custom fields1"
    },
    {
      "parameters": {
        "jsCode": "// 1) Asana custom fields metadata (from HTTP node)\nconst fields = $input.first().json.data \n\n// 2) Brief data (from Set Data node, for example)\nconst brief = $items(\"Add variables when update\")[0].json;\n\n// Helper to find matching enum_option object\nfunction getEnumMatch(fieldName, value) {\n  const field = fields.find(f => f.name.toLowerCase() === fieldName.toLowerCase());\n  if (!field || !field.enum_options) return null;\n\n  // Try to match ignoring case and trimming\n  return field.enum_options.find(opt =>\n    opt.name.toLowerCase().trim() === String(value).toLowerCase().trim()\n  ) || null;\n}\n\n// Build output object: map each brief property to its matching enum_option\nconst result = {\n  briefNumber: brief.briefNumber,\n  authorName: brief.authorName,\n  editorName: brief.editorName,\n  variation: getEnumMatch(\"Variation\", brief.variation),\n  type: getEnumMatch(\"Type\", brief.type),\n  format: getEnumMatch(\"Format\", brief.format),\n  lp: getEnumMatch(\"Landing Page\", brief.lp),\n  adConcept: getEnumMatch(\"Ad Concepts\", brief.adConcept),\n  launchPriority: getEnumMatch(\"Launch Priority\", brief.launchPriority),\n  briefLink: brief.briefLink,\n  driveLink: brief.driveLink,\n  taskGid: brief.taskGid,\n};\n\nreturn [{ json: result }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        496,
        256
      ],
      "id": "fb436249-8222-498c-a9f8-aafbb159e8e3",
      "name": "Matching custom fields"
    },
    {
      "parameters": {
        "jsCode": "// 1) Asana custom fields metadata (from HTTP node)\nconst fields = $input.first().json.data; \n\n// 2) Brief data (from Set Data node, for example)\nconst brief = $items(\"Add variables\")[0].json;\n\n// Helper to find matching enum_option object\nfunction getEnumMatch(fieldName, value) {\n  const field = fields.find(f => f.name.toLowerCase() === fieldName.toLowerCase());\n  if (!field || !field.enum_options) return null;\n\n  // Try to match ignoring case and trimming\n  return field.enum_options.find(opt =>\n    opt.name.toLowerCase().trim() === String(value).toLowerCase().trim()\n  ) || null;\n}\n\n// Build output object: map each brief property to its matching enum_option\nconst result = {\n  briefNumber: brief.briefNumber,\n  authorName: brief.authorName,\n  editorName: brief.editorName,\n  variation: getEnumMatch(\"Variation\", brief.variation),\n  type: getEnumMatch(\"Type\", brief.type),\n  format: getEnumMatch(\"Format\", brief.format),\n  lp: getEnumMatch(\"Landing Page\", brief.lp),\n  adConcept: getEnumMatch(\"Ad Concepts\", brief.adConcept),\n  launchPriority: getEnumMatch(\"Launch Priority\", brief.launchPriority),\n  briefLink: brief.briefLink,\n  driveLink: brief.driveLink,\n  taskGid: brief.taskGid,\n};\n\nreturn [{ json: result }];\n"
      },
