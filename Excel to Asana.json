    {
      "parameters": {
        "jsCode": "const items = $input.all().map(({ json }) => {\n  const base = json.fillDate ? new Date(json.fillDate) : new Date();\n  const dow = base.getDay(); // 0=Sun, 1=Mon ... 5=Fri, 6=Sat\n  let add = 0;\n\n  if (dow >= 1 && dow <= 4) {      // Mon–Thu → this Friday\n    add = 5 - dow;\n  } else if (dow === 5) {          // Friday → next Friday\n    add = 7;\n  } else if (dow === 6) {          // Saturday → next Friday\n    add = 6;\n  } else {                         // Sunday → next Friday\n    add = 5;\n  }\n\n  const due = new Date(base);\n  due.setDate(base.getDate() + add);\n  json.due_on = due.toISOString().slice(0, 10);\n  return { json };\n});\nreturn items;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
