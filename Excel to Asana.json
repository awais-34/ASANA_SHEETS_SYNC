    {
      "parameters": {
        "jsCode": "// Input from previous nodes\nconst tagsResponse = $input.first().json.data;  // HTTP module output (all tags)\nconst item = $items(\"Add variables\")[0].json; // Your set data item\n\n// Names to match\nconst namesToMatch = [item.authorName, item.editorName];\n\n// Filter tags where name matches either authorName or editorName\nconst matchedTags = tagsResponse.filter(tag => namesToMatch.includes(tag.name));\n\n// Return them (so you can use gid later)\nreturn matchedTags.map(tag => ({\n  json: {\n    name: tag.name,\n    gid: tag.gid,\n  }\n}));\n"
      },
